generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth / Users ----------

enum Role {
  PARENT
  TEACHER
  STUDENT
  ADMIN
  // writes for the public blog (own panel at /blogger)
  BLOGGER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  avatarUrl    String?
  // false = the account cannot sign in (set from the admin panel); its data is kept
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentProfile  ParentProfile?
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  blogAuthor     BlogAuthor?

  notifications    Notification[]
  attendanceMarked Attendance[]   @relation("AttendanceMarkedBy")
  auditLogs        AuditLog[]
}

model ParentProfile {
  id            String           @id @default(cuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Portal notification preferences (Tənzimləmələr → Bildirişlər toggles)
  notifyLessons Boolean          @default(true)
  notifyGrades  Boolean          @default(true)
  children      StudentProfile[]
  payments      Payment[]
}

model TeacherProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position        String
  bio             String   @db.Text
  experienceYears Int
  specializations String[]
  photoUrl        String?
  // tell the teacher when a student hands in homework
  notifySubmissions        Boolean @default(true)
  // tell the teacher when a student's attendance falls below 75%
  notifyAttendanceWarnings Boolean @default(true)

  classes ClassGroup[]
  courses Course[]
  notes   StudentNote[]
}

model StudentProfile {
  id           String        @id @default(cuid())
  userId       String?       @unique
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId     String
  parent       ParentProfile @relation(fields: [parentId], references: [id], onDelete: Restrict)
  firstName    String
  lastName     String
  birthDate    DateTime
  avatarUrl    String?
  // school grade (1-11); FIN kept like scholarship FINs: keyed hash for lookup, encrypted for admins
  grade        Int?
  finHash      String?       @unique
  finEncrypted String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  level        Int           @default(1)
  xp           Int           @default(0)
  points       Int           @default(0)
  streakDays   Int           @default(0)

  enrollments   Enrollment[]
  attendance    Attendance[]
  submissions   Submission[]
  progress      SkillProgress[]
  studentBadges StudentBadge[]
  projects      Project[]
  grades        Grade[]
  notes         StudentNote[]
  payments      Payment[]
  applications  TrialBooking[]

  @@index([parentId])
}

// ---------- Courses / Curriculum ----------

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum LessonStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Course {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  shortDesc      String
  longDesc       String          @db.Text
  category       String // lookup key for the icon/color in the UI (e.g. "cybersecurity", "python")
  coverImageUrl  String?
  minAge         Int
  maxAge         Int
  level          Level
  durationMonths Int
  lessonsPerWeek Int
  lessonMinutes  Int
  price          Int // AZN / month
  tags           String[]
  featured       Boolean         @default(false)
  // inactive courses disappear from the public site and from new-class pickers; classes/history stay
  active         Boolean         @default(true)
  teacherId      String?
  teacher        TeacherProfile? @relation(fields: [teacherId], references: [id])
  createdAt      DateTime        @default(now())

  modules       CourseModule[]
  skills        String[]
  enrollments   Enrollment[]
  classes       ClassGroup[]
  trialBookings TrialBooking[]

  @@index([active])
  @@index([teacherId])
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  summary  String

  @@index([courseId])
}

model Enrollment {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  classId   String?
  class     ClassGroup?    @relation(fields: [classId], references: [id])
  startedAt DateTime       @default(now())
  status    String         @default("active") // active | completed | paused

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([courseId])
}

model ClassGroup {
  id                     String         @id @default(cuid())
  name                   String
  courseId               String
  course                 Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacherId              String
  teacher                TeacherProfile @relation(fields: [teacherId], references: [id])
  schedule               String // e.g. "Ç.a - Cümə, 18:00"
  // Expected session count for a full month of this recurring weekly class,
  // set by the teacher (e.g. 2 lessons/week ≈ 8/month). Used as the "y" in
  // the parent-facing "x/y classes attended this month" figure.
  monthlyExpectedClasses Int            @default(8)
  // ACTIVE classes are what teachers/students/parents see; ARCHIVED ones keep their
  // lessons, payments and audit trail but disappear from the dashboards.
  status                 ClassStatus    @default(ACTIVE)
  archivedAt             DateTime?
  // completed lessons per payment cycle (the 8-lesson rule)
  lessonsPerCycle        Int            @default(8)
  // maximum number of students; null = no limit
  capacity               Int?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @default(now()) @updatedAt

  enrollments Enrollment[]
  lessons     Lesson[]
  payments    Payment[]

  @@index([teacherId])
  @@index([status])
  @@index([courseId])
}

model Lesson {
  id              String       @id @default(cuid())
  classId         String
  class           ClassGroup   @relation(fields: [classId], references: [id], onDelete: Cascade)
  title           String
  description     String       @db.Text
  date            DateTime
  materialsUrl    String?
  videoUrl        String?
  status          LessonStatus @default(SCHEDULED)
  // null = the course's lessonMinutes; room is optional (conflicts are checked when set)
  durationMinutes Int?
  room            String?

  attendance Attendance[]
  homeworks  Homework[]

  @@index([classId, date])
  @@index([date])
}

// ---------- Attendance / Homework / Progress ----------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status     AttendanceStatus
  note       String?
  date       DateTime
  // audit: which user last marked it and when
  markedById String?
  markedBy   User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  updatedAt  DateTime         @default(now()) @updatedAt
  // the teacher confirmed the student took part in the lesson; only completed lessons count
  // towards the payment cycle (rows from before this feature stay false)
  completed  Boolean          @default(false)

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([markedById])
}

model Homework {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  dueDate     DateTime
  // highest score the teacher can give for this task (the "Maksimal bal" field of the new-homework form)
  maxScore    Int      @default(100)

  submissions Submission[]
  files       HomeworkFile[]

  @@index([lessonId])
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  OVERDUE
}

model Submission {
  id          String           @id @default(cuid())
  homeworkId  String
  homework    Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      SubmissionStatus @default(PENDING)
  score       Int?
  feedback    String?
  submittedAt DateTime?

  grade Grade?

  @@index([homeworkId])
  @@index([studentId])
}

model Grade {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionId String?        @unique
  submission   Submission?    @relation(fields: [submissionId], references: [id])
  subject      String
  score        Int
  maxScore     Int            @default(100)
  createdAt    DateTime       @default(now())

  @@index([studentId])
}

model SkillProgress {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill     String
  percent   Int
  updatedAt DateTime       @updatedAt

  @@index([studentId])
}

// ---------- Gamification ----------

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  emoji       String
  description String

  studentBadges StudentBadge[]
}

model StudentBadge {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge          @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime       @default(now())

  @@index([badgeId])
  @@index([studentId])
}

model Project {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title        String
  description  String         @db.Text
  imageUrl     String
  technologies String[]
  courseTag    String
  createdAt    DateTime       @default(now())

  @@index([studentId])
}

// ---------- Payments ----------

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  DUE // a payment cycle was reached and is waiting to be paid
  CANCELLED
}

model Payment {
  id                 String          @id @default(cuid())
  parentId           String
  parent             ParentProfile   @relation(fields: [parentId], references: [id], onDelete: Restrict)
  title              String
  amount             Int
  status             PaymentStatus
  dueDate            DateTime
  paidAt             DateTime?
  invoiceNo          String          @unique
  // Set when a parent uploads a cheque/receipt photo; moves status to PENDING
  // pending admin confirmation.
  receiptUrl         String?
  receiptSubmittedAt DateTime?
  // Lesson-based billing: one row per (student, class, cycle). The unique key makes the
  // "8 lessons reached" event idempotent. Both links survive deletion of the student/class.
  studentId          String?
  student            StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  classId            String?
  class              ClassGroup?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  cycle              Int?
  lessonsFrom        Int?
  lessonsTo          Int?
  createdAt          DateTime        @default(now())

  @@unique([studentId, classId, cycle])
  @@index([status])
  @@index([studentId])
  @@index([classId])
  @@index([parentId])
}

// ---------- Marketing / CRM ----------

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String // "Valideyn" | "Tələbə"
  courseTag String
  rating    Int
  quote     String  @db.Text
  avatarUrl String
  featured  Boolean @default(true)
}

enum LeadStage {
  NEW
  CONTACTED
  TRIAL_LESSON
  TRIAL_COMPLETED
  INTERESTED
  REGISTERED
  REJECTED
}

model TrialBooking {
  id                 String          @id @default(cuid())
  parentName         String
  parentPhone        String
  studentName        String
  studentAge         Int
  courseId           String?
  course             Course?         @relation(fields: [courseId], references: [id])
  preferredDate      DateTime
  preferredTime      String
  stage              LeadStage       @default(NEW)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt
  adminNote          String?
  // set when the application was turned into a student account
  convertedStudentId String?
  convertedStudent   StudentProfile? @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)

  @@index([stage])
  @@index([createdAt])
  @@index([convertedStudentId])
  @@index([courseId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String
  type       String   @default("info") // info | success | warning | error
  read       Boolean  @default(false)
  // the record the notification is about (e.g. "attendance" + Attendance.id)
  entityType String?
  entityId   String?
  // machine-readable kind: PAYMENT_DUE, NEW_APPLICATION, NEW_STUDENT, CLASS_ASSIGNED, TEACHER_ASSIGNED, ABSENCE ...
  event      String?
  createdAt  DateTime @default(now())

  @@index([userId, read])
  @@index([event])
}

// ---------- Notes / audit ----------

enum NoteVisibility {
  PRIVATE // teacher only
  PARENT // teacher + the student's parent
  STUDENT // teacher + student + parent
}

// A teacher's note about a student. Who may read it is decided by
// `visibility`; every dashboard reads the same rows through src/lib/access.ts.
model StudentNote {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  body       String         @db.Text
  visibility NoteVisibility @default(PARENT)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt

  @@index([studentId])
  @@index([teacherId])
}

// Who changed what: written in the same transaction as the change itself.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String // e.g. "attendance.mark", "grade.set", "homework.create", "note.create", "lesson.create"
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
}

// ---------- Scholarship exam ("Reqamsal Gələcək") ----------
// Scholarship candidates are not portal users (no email/role), so they get their own
// FIN + password identity instead of a User row. The question bank is imported from the
// DOCX files in /questions by scripts/scholarship/parse-questions.mjs -> prisma/scholarship
// -> scripts/scholarship-sync.mjs; nothing parses DOCX at request time.

enum ScholarshipSubject {
  LOGIC
  MATH
  ENGLISH
}

enum ScholarshipAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model ScholarshipCategory {
  key        String @id // "1-2", "11" — taken from the question file name
  label      String // "1–2-ci sinif"
  gradeFrom  Int
  gradeTo    Int
  sortOrder  Int
  sourceFile String

  questions ScholarshipQuestion[]
  students  ScholarshipStudent[]
}

model ScholarshipQuestion {
  id           String              @id @default(cuid())
  categoryKey  String
  category     ScholarshipCategory @relation(fields: [categoryKey], references: [key], onDelete: Cascade)
  subject      ScholarshipSubject
  part         Int                 @default(1) // "Riyaziyyat 1" / "Riyaziyyat 2" in the source
  number       Int // number in the source file (matches its answer key)
  position     Int // order within the category's exam
  stem         String              @db.Text // sanitized rich text (text, <sup>/<sub>, MathML)
  options      Json // [{ label: "A", html: "..." }]; empty = typed answer
  imageIds     String[]
  correctLabel String? // "A".."E"
  answerText   String? // for typed answers
  translations Json? // { en: { stem, options: [{label, html}] }, ru: { ... } }; Azerbaijani is the base text
  updatedAt    DateTime            @updatedAt

  @@unique([categoryKey, subject, part, number])
  @@index([categoryKey, position])
}

model ScholarshipMedia {
  id          String @id // content hash
  contentType String
  data        Bytes
}

model ScholarshipStudent {
  id           String              @id @default(cuid())
  name         String
  surname      String
  phone        String
  email        String
  language     String              @default("az") // exam language chosen at registration: az | en | ru
  program      String              @default("") // program the candidate wants: cybersecurity | electronics | programming | robotics | ai
  finHash      String              @unique // HMAC-SHA256 of the normalised FIN (lookup + uniqueness)
  finEncrypted String // AES-256-GCM, only readable with the server key (shown to admins)
  categoryKey  String
  category     ScholarshipCategory @relation(fields: [categoryKey], references: [key])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  attempts ScholarshipAttempt[]
  code     ScholarshipCode?

  @@index([categoryKey])
}

// A 32-character code the school hands to its own course students. Registration (and
// therefore the exam) is impossible without an unused code, and each code works once.
model ScholarshipCode {
  id        String              @id @default(cuid())
  code      String              @unique
  note      String? // admin label, e.g. the group it was issued to
  createdAt DateTime            @default(now())
  usedAt    DateTime?
  studentId String?             @unique
  student   ScholarshipStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

model ScholarshipAttempt {
  id                 String                   @id @default(cuid())
  studentId          String                   @unique // one exam attempt per student
  student            ScholarshipStudent       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status             ScholarshipAttemptStatus @default(IN_PROGRESS)
  startedAt          DateTime                 @default(now())
  expiresAt          DateTime
  finishedAt         DateTime?
  questionIds        String[] // frozen at start, in exam order
  answers            Json                     @default("{}") // { [questionId]: "B" | "typed text" }
  score              Int?
  total              Int
  percent            Int?
  scholarshipPercent Int? // discount earned, derived from percent (see SCHOLARSHIP_TIERS)
  subjectScores      Json? // { LOGIC: { correct, total }, ... }
  timedOut           Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

// ---------- School settings ----------
// Key/value configuration edited from /admin/settings (defaults live in src/lib/settings.ts).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

// ---- Blog ----

enum BlogStatus {
  DRAFT
  PUBLISHED
}

/// Public byline of a BLOGGER account (the name and photo come from User).
model BlogAuthor {
  id       String     @id @default(cuid())
  userId   String     @unique
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  position String     @default("Bloq müəllifi")
  bio      String     @default("")
  posts    BlogPost[]
}

model BlogPost {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  excerpt         String     @default("")
  /// Markdown. Rendered without raw HTML.
  content         String     @db.Text
  coverUrl        String?
  coverAlt        String     @default("")
  category        String
  tags            String[]
  status          BlogStatus @default(DRAFT)
  /// When the post goes live. A PUBLISHED post with a date in the future is scheduled and not shown yet.
  publishedAt     DateTime?
  featured        Boolean    @default(false)
  metaTitle       String     @default("")
  metaDescription String     @default("")
  views           Int        @default(0)
  readingMinutes  Int        @default(1)
  authorId        String
  author          BlogAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@index([authorId])
}

/// A file the teacher attaches to a homework (worksheet, task sheet, starter code ...). The bytes live in the
/// database, not on the server's disk: the host's disk is wiped on every deploy. Uploaded first (homeworkId null),
/// linked when the homework is created; unlinked leftovers are swept after a day.
model HomeworkFile {
  id         String    @id @default(cuid())
  homeworkId String?
  homework   Homework? @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  /// User.id of the teacher who uploaded it
  uploaderId String
  filename   String
  mime       String
  size       Int
  data       Bytes
  createdAt  DateTime  @default(now())

  @@index([homeworkId])
  @@index([uploaderId, createdAt])
}
